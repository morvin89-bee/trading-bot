# Salin berkas ini menjadi `.env` lalu isi nilainya. `.env` masuk .gitignore.

# --- Kunci Indodax (https://indodax.com/trade_api) ---
# Izin key mengikuti tahap, dan JANGAN PERNAH diberi izin Withdraw:
#   - Periode bayangan (7 hari): "Reading (View Only)" sudah cukup.
#   - Go-live: harus "View + Trade (Spot)" tanpa Withdraw.
# Isi untuk perintah "python dca_tracker.py sync" (tarik riwayat otomatis).
INDODAX_KEY=
INDODAX_SECRET=
TOKO_API_KEY=
TOKO_SECRET=

# --- Izin deklaratif eksekusi ---
# Indodax TIDAK mengekspos izin key lewat API, jadi izin dinyatakan di sini.
# Hanya "1" persis dianggap aktif; kosong atau selain "1" = TIDAK aktif.
# Keduanya kosong = permissions_ok MENGHENTIKAN bot, bukan mengirim (aman).
#
# Isi `INDODAX_CAN_TRADE=1` HANYA pada saat memutuskan live, bersamaan
# dengan memanggil `aktifkan_live`. Mengisinya lebih awal membuat bot
# berhenti di tiap denyut (sakelar mati + kunci bisa trading).
INDODAX_CAN_TRADE=
# JANGAN PERNAH diisi 1. Key pun sudah tanpa izin Withdraw; baris ini pengaman
# yang memastikan jalur tarik-dana tak pernah terbuka walau key salah izin.
INDODAX_CAN_WITHDRAW=

# --- Bot Telegram (wajib untuk bot jalan; tombol Setuju memakai ini) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opsional ---
# Alamat Tailscale untuk dashboard; bila kosong tampil "N/A".
TAILSCALE_IP=
